{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(?:www\\.)?getset7\\.com\\.br$"
        }
      ],
      "destination": "/apresentacao/index.html"
    },
    {
      "source": "/(style\\.css|script\\.js|slides\\.js)",
      "has": [
        {
          "type": "host",
          "value": "^(?:www\\.)?getset7\\.com\\.br$"
        }
      ],
      "destination": "/apresentacao/$1"
    },
    {
      "source": "/assets/:match*",
      "has": [
        {
          "type": "host",
          "value": "^(?:www\\.)?getset7\\.com\\.br$"
        }
      ],
      "destination": "/apresentacao/assets/:match*"
    },
    {
      "source": "/apresentacao",
      "destination": "/apresentacao/index.html"
    },
    {
      "source": "/apresentacao/",
      "destination": "/apresentacao/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(?:apresentacao/)?assets/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/(?:apresentacao/)?assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
