{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "getset7.vercel.app"
        }
      ],
      "destination": "/apresentacao/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "getset7.com.br"
        }
      ],
